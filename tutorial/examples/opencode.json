{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "ollama/gemma4:12b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "gemma4:12b": {
          "name": "Gemma 4 12B (local)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "permission": {
    "edit": { "*": "deny", "scripts/*": "allow",
              "data/processed/*": "allow", "logs/*": "allow" },
    "bash": { "*": "deny", "Rscript scripts/*": "allow",
              "git reset --hard*": "deny", "git clean*": "deny",
              "git push*": "deny" },
    "webfetch": "deny"
  }
}
